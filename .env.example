# Copy to .env and adjust as needed. server/config.py loads this via python-dotenv.
# POSTGRES_USER/PASSWORD/DB are read by docker-compose.yml to create the Postgres role/db;
# DATABASE_URL is what server/config.py uses to connect and must match them.

POSTGRES_USER=USERNAME
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=DBNAME
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/DBNAME
GRPC_HOST=[::]
GRPC_PORT=50051
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
DEFAULT_LOAN_PERIOD_DAYS=14
